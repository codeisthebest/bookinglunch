# 複製成 .env 後填寫。.env 含機密，請勿提交到 git。

# 對外埠號（容器內固定 3000）
HOST_PORT=3000

# 首次啟動時建立管理員 admin 的密碼（至少 8 字元）。之後密碼存在資料裡，改這裡不會生效。
ADMIN_PASSWORD=請改成強密碼

# 動態取餐碼的簽章金鑰：請用隨機長字串，例如 openssl rand -hex 32
# 不設定也能跑，但每次重啟會換金鑰（只讓當下的舊 QR Code 失效）
QR_SECRET=

# LINE 登入（兩個都設才會啟用；沒設定時是只憑員編的展示用登入，不可用於正式環境）
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=
